# Модель подключается через OpenAI-совместимый API (/chat/completions).
# Для модели организатора укажите выданные адрес, ключ и идентификатор модели.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace_with_your_key
LLM_MODEL=qwen/qwen3.8-27b:free
# Только для OpenRouter: разрешить платные модели
ALLOW_PAID_MODEL=false
# Старые имена OPENROUTER_API_KEY / OPENROUTER_MODEL / OPENROUTER_BASE_URL тоже поддерживаются.
